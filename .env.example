# Copy to .env (never commit it) or set these as secrets on the host.

# Enables the visual analysis signal. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: model used for the visual check (default claude-opus-5-5)
# OBSERVATORY_MODEL=claude-opus-5-5

# Optional: reads YouTube's synthetic-content label. https://console.cloud.google.com
YOUTUBE_API_KEY=

# Public deployments: cost control
ALLOW_LIVE=1
LIVE_LIMIT_PER_IP=3
LIVE_LIMIT_PER_DAY=30
