# Copy to .env (never commit it) or set these as secrets on the host.

# Visual analysis signal: set ONE of these. If both are set, Groq is used
# unless VISION_PROVIDER=anthropic.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# OBSERVATORY_MODEL=claude-opus-5-5
# VISION_PROVIDER=groq

# Benchmark only (observatory bench): other providers to compare.
# Set the model you want to test; names change often, so there is no default.
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=
GEMINI_API_KEY=
# GEMINI_VISION_MODEL=
# Commercial detectors. Sightengine free tier: https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Hive's model via NVIDIA: https://build.nvidia.com/hive/ai-generated-image-detection
NVIDIA_API_KEY=

# Optional: reads YouTube's synthetic-content label. https://console.cloud.google.com
YOUTUBE_API_KEY=

# Public deployments: cost control
ALLOW_LIVE=1
LIVE_LIMIT_PER_IP=3
LIVE_LIMIT_PER_DAY=30
# Visitors may paste their own vision key in the form (works even with ALLOW_LIVE=0)
ALLOW_BYOK=1
BYOK_LIMIT_PER_IP=20
